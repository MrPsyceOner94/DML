# Application
APP_NAME=DML
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://dml_user:dml_password@localhost:5432/dml_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Authentication
DML_ADMIN_PASSWORD=admin-password
JWT_EXPIRY=86400
JWT_ALGORITHM=HS256

# NRL Fantasy API
NRL_API_KEY=your-nrl-api-key
NRL_API_BASE_URL=https://api.nrl.com/fantasy
NRL_API_TIMEOUT=30

# WebSocket
WS_PORT=8000
WS_WORKERS=4
WS_HEARTBEAT=30

# ML Models
MODEL_PATH=/app/models
PREDICTIONS_CACHE_TTL=3600
PREDICTIONS_MIN_CONFIDENCE=0.75

# Features
ENABLE_LIVE_SCORING=true
ENABLE_PREDICTIONS=true
ENABLE_TRADE_RECOMMENDATIONS=true
ENABLE_ALERTS=true
ENABLE_CHAT=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# External Services
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@dml-league.local
SMTP_PASSWORD=your-email-password
SMTP_FROM=DML <notifications@dml-league.local>

# Alerts
ALERT_INJURY_NOTIFY=true
ALERT_SUSPENSION_NOTIFY=true
ALERT_TRADE_SUGGEST_NOTIFY=true
ALERT_LINEUP_LOCK_REMIND=true
